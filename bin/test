#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

qmake6 "$ROOT/tests/omawave_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen ./omawave_tests
/usr/bin/python3 -m unittest discover -s "$ROOT/catalog/tests"
node --test "$ROOT/plugin/tests/"
