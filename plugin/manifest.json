{
  "schemaVersion": 1,
  "id": "vp.omawave",
  "name": "omawave",
  "version": "0.1.0",
  "author": "vp",
  "license": "MIT",
  "description": "omawave now playing: live visualizer, scrolling title and a mini player.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "omawave",
    "description": "Visualizer + title; click for the mini player",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "centerBegin",
    "defaults": { "maxLabelWidth": 180, "showTitle": true },
    "schema": [
      { "key": "maxLabelWidth", "type": "integer", "label": "Title width", "min": 60, "max": 400, "step": 10, "defaultValue": 180 },
      { "key": "showTitle", "type": "boolean", "label": "Show title", "defaultValue": true }
    ]
  }
}
